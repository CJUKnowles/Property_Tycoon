script/source = "extends Node2D
class_name Bank

var money: int = 50000

func pay_player(player, amount: int):
	print(\"Bank pays \" + player.name + \" £\" + str(amount))
	player.money += amount
	money -= amount

func receive_payment(player, amount: int):
	print(player.name + \" pays the bank £\" + str(amount))
	player.charge(amount)
	money += amount

